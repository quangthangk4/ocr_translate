{
  "name": "comic-lens",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "windows:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/windows-ocr/Build.ps1",
    "windows:zip": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/windows-ocr/Package.ps1",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/windows-ocr/Test.ps1",
    "ocr:assets": "node scripts/ocr-assets.mjs",
    "predev": "npm run ocr:assets",
    "dev": "wxt",
    "prebuild": "npm run ocr:assets",
    "build": "wxt build",
    "prezip": "npm run ocr:assets",
    "zip": "wxt zip",
    "postinstall": "node scripts/ocr-assets.mjs && wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.20",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  }
}
